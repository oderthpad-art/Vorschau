# Security headers for Apache-compatible hosting with mod_headers.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-8iBa25k3xwLKusqVjmFz/EmR7IdZ+pxVAqciDxCABnM=' 'sha256-arClI716T3dNJtEBWQxJ6tkzDHED2YjqV/eV/noeSuA=' 'sha256-tdeZQ3U10C4MVEAPpF4Ck2yw2hvHaO9LW1gph+JA3BU='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    Header always set X-Frame-Options "DENY"
</IfModule>
